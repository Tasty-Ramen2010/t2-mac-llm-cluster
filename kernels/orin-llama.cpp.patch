+static bool mmvq_id_warp_enabled() {
+    static const int v = [] { const char * e = getenv("GGML_MMVQ_ID_WARP"); return e ? atoi(e) : 0; }();
+    return v != 0;
+}
+
+template <ggml_type type>
+static bool try_mul_mat_vec_q_id_warp(
+        const void * vx, const void * vy, const int32_t * ids, const ggml_cuda_mm_fusion_args_device & fusion, float * dst,
+        const int ncols_x, const int nrows_x, const int ncols_dst, const int stride_row_x, const int stride_col_y, const int stride_col_dst,
+        const int nchannels_y, const int nchannels_dst, const int stride_channel_x, const int stride_channel_y, const int stride_channel_dst,
+        const int nsamples_x, const int nsamples_dst, const int ids_stride, cudaStream_t stream) {
+    if constexpr (type == GGML_TYPE_IQ3_S || type == GGML_TYPE_IQ4_XS || type == GGML_TYPE_Q6_K) {
+        if (!mmvq_id_warp_enabled() || ids == nullptr || ncols_dst < 1 || ncols_dst > 8 || nsamples_x != 1 || nsamples_dst != 1) {
+            return false;
+        }
+        if (fusion.shared_up != nullptr || fusion.x_bias != nullptr || fusion.gate_bias != nullptr) {
+            return false;
+        }
+        if (fusion.gate != nullptr && fusion.glu_op != GGML_GLU_OP_SWIGLU) {
+            return false;
+        }
+        constexpr int qk = ggml_cuda_type_traits<type>::qk, qi = ggml_cuda_type_traits<type>::qi, vdr = get_vdr_mmvq(type);
+        const int slots = (ncols_x / qk) * (qi / vdr);
+        const int rpw   = (slots == 16) ? 2 : 1;
+        if (slots != 16 && slots < 32) {
+            return false;
+        }
+        const int sm = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+        const int ctas = sm * 4;
+        const uint3 nch_y_fd = init_fastdiv_values(nchannels_y);
+        const bool gate = fusion.gate != nullptr;
+#define LAUNCH_IDW(G, R) mul_mat_vec_q_id_warp<type, G, R><<<ctas, 256, 0, stream>>>(vx, fusion.gate, vy, ids, dst, ncols_x, nrows_x, nch_y_fd, \
+            (uint32_t) stride_row_x, (uint32_t) stride_channel_x, (uint32_t) stride_channel_y, (uint32_t) stride_channel_dst, \
+            (uint32_t) stride_col_y, (uint32_t) stride_col_dst, (uint32_t) ids_stride, nchannels_dst, ncols_dst)
+        if (gate) { if (rpw == 2) { LAUNCH_IDW(true, 2); } else { LAUNCH_IDW(true, 1); } }
+        else      { if (rpw == 2) { LAUNCH_IDW(false, 2); } else { LAUNCH_IDW(false, 1); } }
+#undef LAUNCH_IDW
+        return true;
+    } else {
+        GGML_UNUSED_VARS(vx, vy, ids, fusion, dst, ncols_x, nrows_x, ncols_dst, stride_row_x, stride_col_y, stride_col_dst, nchannels_y,
+                         nchannels_dst, stride_channel_x, stride_channel_y, stride_channel_dst, nsamples_x, nsamples_dst, ids_stride, stream);
+        return false;
+    }
+}
