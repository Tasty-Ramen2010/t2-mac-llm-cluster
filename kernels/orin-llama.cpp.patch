+            snprintf(b2, sizeof(b2), " src%d=%s{%s %ldx%ldx%ld nb1=%ld}", k, t->src[k]->name, ggml_type_name(t->src[k]->type),
+                     (long) t->src[k]->ne[0], (long) t->src[k]->ne[1], (long) t->src[k]->ne[2], (long) t->src[k]->nb[1]);
