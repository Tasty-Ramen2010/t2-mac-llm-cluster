+    size_t d = name.size();
+    while (d > 0 && isdigit((unsigned char) name[d - 1])) d--;
+    if (d > 0 && d < name.size() && name[d - 1] == '-') name.resize(d - 1);
+    char buf[256];
+    const char * st = t->src[0] ? ggml_type_name(t->src[0]->type) : "";
+    snprintf(buf, sizeof(buf), "%-14s %-22s [%s] %ldx%ldx%ld", ggml_op_name(t->op), name.c_str(), st, (long) t->ne[0], (long) t->ne[1], (long) t->ne[2]);
+    std::string out = buf;
+    if ((t->op == GGML_OP_MUL_MAT || t->op == GGML_OP_MUL_MAT_ID) && t->src[0] && getenv("GGML_CUDA_PROF_BY_WEIGHT")) {
+        std::string w = t->src[0]->name;                    // group by weight tensor without the layer number: blk.12.attn_qkv.weight -> attn_qkv
+        size_t a = w.find("blk."); if (a == 0) { size_t b = w.find('.', 4); if (b != std::string::npos) w = w.substr(b + 1); }
+        snprintf(buf, sizeof(buf), "%-14s W=%-26s [%s] %ldx%ld", ggml_op_name(t->op), w.c_str(), t->src[0] ? ggml_type_name(t->src[0]->type) : "", (long) t->src[0]->ne[0], (long) t->src[0]->ne[1]);
