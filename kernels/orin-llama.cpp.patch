+// ---------------------------------------------------------------------------------------------------------------------------
+// MoE decode/verify kernel (expert ids, 1..8 tokens): persistent warp-per-row, no shared memory, no __syncthreads, optional fused
+// gate/up + SwiGLU. The stock kernels launch thousands of short-lived blocks (one per expert row): launch + block-wide reduction
+// latency x ~20 waves dominates (about 3x slower than the memory system allows on small unified-memory GPUs).
+// Enabled for IQ3_S / IQ4_XS / Q6_K experts. GGML_MMVQ_ID_WARP=1 turns it on (0 = stock kernels).
+// ---------------------------------------------------------------------------------------------------------------------------
+template <ggml_type type, bool use_gate, int rows_per_warp>
+__launch_bounds__(256)
+static __global__ void mul_mat_vec_q_id_warp(
+        const void * __restrict__ vx, const void * __restrict__ vgate, const void * __restrict__ vy, const int32_t * __restrict__ ids,
+        float * __restrict__ dst, const int ncols_x, const int nrows_x, const uint3 nchannels_y_fd, const uint32_t stride_row_x,
+        const uint32_t stride_channel_x, const uint32_t stride_channel_y, const uint32_t stride_channel_dst,
+        const uint32_t stride_col_y, const uint32_t stride_col_dst,
+        const uint32_t ids_stride, const int n_used, const int n_tokens) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+    constexpr int lanes_per_block = qi / vdr;
+
+    const int blocks_per_row = ncols_x / qk;
+    const int slots          = blocks_per_row * lanes_per_block;          // (block, quant-subset) work items per row
+    const int lane           = threadIdx.x & 31;
+    const int lanes_per_row  = rows_per_warp == 1 ? 32 : slots;           // rows_per_warp == 2 only used when slots == 16
+    const int sub            = rows_per_warp == 1 ? 0 : lane / lanes_per_row;
+    const int lane_in_row    = rows_per_warp == 1 ? lane : lane % lanes_per_row;
+    const int gwarp          = blockIdx.x * (blockDim.x >> 5) + (threadIdx.x >> 5);
+    const int nwarps_total   = gridDim.x * (blockDim.x >> 5);
+    const int row_groups     = (nrows_x + rows_per_warp - 1) / rows_per_warp;
+    const int per_token      = n_used * row_groups;
+    const int total          = n_tokens * per_token;
+
+    ggml_cuda_pdl_sync();
+    for (int g = gwarp; g < total; g += nwarps_total) {
+        const int token = g / per_token;
+        const int rem   = g - token * per_token;
+        const int slot  = rem / row_groups;
+        const int row   = (rem - slot * row_groups) * rows_per_warp + sub;
+        const uint32_t channel_x = ids[slot + token * ids_stride];
+        const uint32_t channel_y = fastmodulo(slot, nchannels_y_fd);
+        const block_q8_1 * y = ((const block_q8_1 *) vy) + channel_y * stride_channel_y + token * stride_col_y;
+        const int kbx_offset = channel_x * stride_channel_x + row * stride_row_x;
+
+        float acc = 0.f, accg = 0.f;
+        if (row < nrows_x) {
+            for (int t = lane_in_row; t < slots; t += (rows_per_warp == 1 ? 32 : lanes_per_row)) {
+                const int kbx = t / lanes_per_block;
+                const int kqs = vdr * (t % lanes_per_block);
+                const int kby = kbx * (qk / QK8_1);
+                acc += vec_dot_q_cuda(vx, &y[kby], kbx_offset + kbx, kqs);
+                if constexpr (use_gate) {
+                    accg += vec_dot_q_cuda(vgate, &y[kby], kbx_offset + kbx, kqs);
+                }
+            }
+        }
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) {
+            if (rows_per_warp == 1 || o < lanes_per_row) {
+                acc += __shfl_xor_sync(0xffffffff, acc, o);
+                if constexpr (use_gate) {
+                    accg += __shfl_xor_sync(0xffffffff, accg, o);
+                }
+            }
+        }
+        if (lane_in_row == 0 && row < nrows_x) {
+            float result = acc;
+            if constexpr (use_gate) {
+                result *= ggml_cuda_op_silu_single(accg);                // SWIGLU: up * silu(gate)
+            }
+            dst[(size_t) slot * stride_channel_dst + (size_t) token * stride_col_dst + row] = result;
+        }
+    }
+}
