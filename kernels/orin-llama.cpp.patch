+// ---- per-op GPU time profiler (GGML_CUDA_PROF=1, run with GGML_CUDA_DISABLE_GRAPHS=1): prints a table at exit ----
+#include <map>
+#include <string>
+#include <algorithm>
+#include <vector>
+struct ggml_cuda_prof_entry { double ms = 0.0; long n = 0; };
+struct ggml_cuda_prof_state {
+    std::map<std::string, ggml_cuda_prof_entry> m;
+    cudaEvent_t e0 = nullptr, e1 = nullptr;
+    bool on = getenv("GGML_CUDA_PROF") != nullptr;
+    long steps = 0;
+    ~ggml_cuda_prof_state() {
+        if (!on || m.empty()) return;
+        std::vector<std::pair<std::string, ggml_cuda_prof_entry>> v(m.begin(), m.end());
+        double tot = 0; for (auto & kv : v) tot += kv.second.ms;
+        std::sort(v.begin(), v.end(), [](auto & a, auto & b) { return a.second.ms > b.second.ms; });
+        fprintf(stderr, "\n=== GGML_CUDA_PROF: total %.1f ms over %ld graph evaluations ===\n", tot, steps);
+        fprintf(stderr, "%8s %6s %9s %8s  %s\n", "ms", "%", "calls", "avg_us", "op  name  [type] dst-shape");
+        int shown = 0;
+        for (auto & kv : v) {
+            if (shown++ >= 70) break;
+            fprintf(stderr, "%8.1f %5.1f%% %9ld %8.1f  %s\n", kv.second.ms, 100.0 * kv.second.ms / tot, kv.second.n, 1000.0 * kv.second.ms / kv.second.n, kv.first.c_str());
+        }
+        long calls = 0; for (auto & kv : m) calls += kv.second.n;
+        fprintf(stderr, "=== per graph evaluation: %.2f ms, %.0f profiled launches/chains ===\n", tot / (steps ? steps : 1), (double) calls / (steps ? steps : 1));
+    }
+};
+static ggml_cuda_prof_state g_cuda_prof;
+static std::string ggml_cuda_prof_key(const ggml_tensor * t) {
