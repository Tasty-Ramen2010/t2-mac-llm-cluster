+// --- fast dim-0 concat (no 64-bit division per element). GGML_CONCAT_SLOW=1 restores the original kernel for A/B tests. ---
+template <typename T>
+static __global__ void __launch_bounds__(CUDA_CONCAT_BLOCK_SIZE) concat_cont_dim0_rows(const T * x, const T * y, T * dst, int64_t ne00, int64_t ne0, int64_t nrows) {
+    ggml_cuda_pdl_sync();
+    const int64_t ne10 = ne0 - ne00;
+    for (int64_t row = blockIdx.x; row < nrows; row += gridDim.x) {
+        const T * xr = x + row * ne00;
+        const T * yr = y + row * ne10;
+        T *       dr = dst + row * ne0;
+        for (int i0 = threadIdx.x; i0 < ne0; i0 += blockDim.x) {
+            dr[i0] = i0 < ne00 ? xr[i0] : yr[i0 - ne00];
+        }
+    }
+}
+
+template <typename T>
+static __global__ void __launch_bounds__(CUDA_CONCAT_BLOCK_SIZE) concat_cont_dim0_small(const T * x, const T * y, T * dst, int ne00, int ne0, int n, uint3 ne0_fd) {
+    ggml_cuda_pdl_sync();
+    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += blockDim.x * gridDim.x) {
+        const int row = (int) fastdiv((uint32_t) i, ne0_fd);
+        const int i0  = i - row * ne0;
+        dst[i] = i0 < ne00 ? x[row * ne00 + i0] : y[row * (ne0 - ne00) + (i0 - ne00)];
+    }
+}
