            acc[0] = fma(kv.s2, sub_group_broadcast(q[0].s1, 2), acc[0]); acc[1] = fma(kv.s2, sub_group_broadcast(q[1].s1, 2), acc[1]); acc[2] = fma(kv.s2, sub_group_broadcast(q[2].s1, 2), acc[2]); acc[3] = fma(kv.s2, sub_group_broadcast(q[3].s1, 2), acc[3]); acc[4] = fma(kv.s2, sub_group_broadcast(q[4].s1, 2), acc[4]); acc[5] = fma(kv.s2, sub_group_broadcast(q[5].s1, 2), acc[5]); acc[6] = fma(kv.s2, sub_group_broadcast(q[6].s1, 2), acc[6]); acc[7] = fma(kv.s2, sub_group_broadcast(q[7].s1, 2), acc[7]);
            acc[0] = fma(kv.s3, sub_group_broadcast(q[0].s1, 3), acc[0]); acc[1] = fma(kv.s3, sub_group_broadcast(q[1].s1, 3), acc[1]); acc[2] = fma(kv.s3, sub_group_broadcast(q[2].s1, 3), acc[2]); acc[3] = fma(kv.s3, sub_group_broadcast(q[3].s1, 3), acc[3]); acc[4] = fma(kv.s3, sub_group_broadcast(q[4].s1, 3), acc[4]); acc[5] = fma(kv.s3, sub_group_broadcast(q[5].s1, 3), acc[5]); acc[6] = fma(kv.s3, sub_group_broadcast(q[6].s1, 3), acc[6]); acc[7] = fma(kv.s3, sub_group_broadcast(q[7].s1, 3), acc[7]);
