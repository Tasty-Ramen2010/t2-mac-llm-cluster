            acc[0] = fma(kv.s0, sub_group_broadcast(q[0].s7, 0), acc[0]); acc[1] = fma(kv.s0, sub_group_broadcast(q[1].s7, 0), acc[1]); acc[2] = fma(kv.s0, sub_group_broadcast(q[2].s7, 0), acc[2]); acc[3] = fma(kv.s0, sub_group_broadcast(q[3].s7, 0), acc[3]); acc[4] = fma(kv.s0, sub_group_broadcast(q[4].s7, 0), acc[4]); acc[5] = fma(kv.s0, sub_group_broadcast(q[5].s7, 0), acc[5]); acc[6] = fma(kv.s0, sub_group_broadcast(q[6].s7, 0), acc[6]); acc[7] = fma(kv.s0, sub_group_broadcast(q[7].s7, 0), acc[7]);
            acc[0] = fma(kv.s1, sub_group_broadcast(q[0].s7, 1), acc[0]); acc[1] = fma(kv.s1, sub_group_broadcast(q[1].s7, 1), acc[1]); acc[2] = fma(kv.s1, sub_group_broadcast(q[2].s7, 1), acc[2]); acc[3] = fma(kv.s1, sub_group_broadcast(q[3].s7, 1), acc[3]); acc[4] = fma(kv.s1, sub_group_broadcast(q[4].s7, 1), acc[4]); acc[5] = fma(kv.s1, sub_group_broadcast(q[5].s7, 1), acc[5]); acc[6] = fma(kv.s1, sub_group_broadcast(q[6].s7, 1), acc[6]); acc[7] = fma(kv.s1, sub_group_broadcast(q[7].s7, 1), acc[7]);
            acc[0] = fma(kv.s2, sub_group_broadcast(q[0].s7, 2), acc[0]); acc[1] = fma(kv.s2, sub_group_broadcast(q[1].s7, 2), acc[1]); acc[2] = fma(kv.s2, sub_group_broadcast(q[2].s7, 2), acc[2]); acc[3] = fma(kv.s2, sub_group_broadcast(q[3].s7, 2), acc[3]); acc[4] = fma(kv.s2, sub_group_broadcast(q[4].s7, 2), acc[4]); acc[5] = fma(kv.s2, sub_group_broadcast(q[5].s7, 2), acc[5]); acc[6] = fma(kv.s2, sub_group_broadcast(q[6].s7, 2), acc[6]); acc[7] = fma(kv.s2, sub_group_broadcast(q[7].s7, 2), acc[7]);
            acc[0] = fma(kv.s3, sub_group_broadcast(q[0].s7, 3), acc[0]); acc[1] = fma(kv.s3, sub_group_broadcast(q[1].s7, 3), acc[1]); acc[2] = fma(kv.s3, sub_group_broadcast(q[2].s7, 3), acc[2]); acc[3] = fma(kv.s3, sub_group_broadcast(q[3].s7, 3), acc[3]); acc[4] = fma(kv.s3, sub_group_broadcast(q[4].s7, 3), acc[4]); acc[5] = fma(kv.s3, sub_group_broadcast(q[5].s7, 3), acc[5]); acc[6] = fma(kv.s3, sub_group_broadcast(q[6].s7, 3), acc[6]); acc[7] = fma(kv.s3, sub_group_broadcast(q[7].s7, 3), acc[7]);
            acc[0] = fma(kv.s4, sub_group_broadcast(q[0].s7, 4), acc[0]); acc[1] = fma(kv.s4, sub_group_broadcast(q[1].s7, 4), acc[1]); acc[2] = fma(kv.s4, sub_group_broadcast(q[2].s7, 4), acc[2]); acc[3] = fma(kv.s4, sub_group_broadcast(q[3].s7, 4), acc[3]); acc[4] = fma(kv.s4, sub_group_broadcast(q[4].s7, 4), acc[4]); acc[5] = fma(kv.s4, sub_group_broadcast(q[5].s7, 4), acc[5]); acc[6] = fma(kv.s4, sub_group_broadcast(q[6].s7, 4), acc[6]); acc[7] = fma(kv.s4, sub_group_broadcast(q[7].s7, 4), acc[7]);
            acc[0] = fma(kv.s5, sub_group_broadcast(q[0].s7, 5), acc[0]); acc[1] = fma(kv.s5, sub_group_broadcast(q[1].s7, 5), acc[1]); acc[2] = fma(kv.s5, sub_group_broadcast(q[2].s7, 5), acc[2]); acc[3] = fma(kv.s5, sub_group_broadcast(q[3].s7, 5), acc[3]); acc[4] = fma(kv.s5, sub_group_broadcast(q[4].s7, 5), acc[4]); acc[5] = fma(kv.s5, sub_group_broadcast(q[5].s7, 5), acc[5]); acc[6] = fma(kv.s5, sub_group_broadcast(q[6].s7, 5), acc[6]); acc[7] = fma(kv.s5, sub_group_broadcast(q[7].s7, 5), acc[7]);
            acc[0] = fma(kv.s6, sub_group_broadcast(q[0].s7, 6), acc[0]); acc[1] = fma(kv.s6, sub_group_broadcast(q[1].s7, 6), acc[1]); acc[2] = fma(kv.s6, sub_group_broadcast(q[2].s7, 6), acc[2]); acc[3] = fma(kv.s6, sub_group_broadcast(q[3].s7, 6), acc[3]); acc[4] = fma(kv.s6, sub_group_broadcast(q[4].s7, 6), acc[4]); acc[5] = fma(kv.s6, sub_group_broadcast(q[5].s7, 6), acc[5]); acc[6] = fma(kv.s6, sub_group_broadcast(q[6].s7, 6), acc[6]); acc[7] = fma(kv.s6, sub_group_broadcast(q[7].s7, 6), acc[7]);
            acc[0] = fma(kv.s7, sub_group_broadcast(q[0].s7, 7), acc[0]); acc[1] = fma(kv.s7, sub_group_broadcast(q[1].s7, 7), acc[1]); acc[2] = fma(kv.s7, sub_group_broadcast(q[2].s7, 7), acc[2]); acc[3] = fma(kv.s7, sub_group_broadcast(q[3].s7, 7), acc[3]); acc[4] = fma(kv.s7, sub_group_broadcast(q[4].s7, 7), acc[4]); acc[5] = fma(kv.s7, sub_group_broadcast(q[5].s7, 7), acc[5]); acc[6] = fma(kv.s7, sub_group_broadcast(q[6].s7, 7), acc[6]); acc[7] = fma(kv.s7, sub_group_broadcast(q[7].s7, 7), acc[7]);
        }
        const float mv = (live && mask) ? vload_half(r, mask) : 0.0f;
        for (int h = 0; h < H; h++) P[h][rl] = live ? acc[h] * scale + mv : -INFINITY;
    }
    barrier(CLK_LOCAL_MEM_FENCE);
    // 2) softmax statistics: subgroup sg handles head sg
    {
        const int h = sg;
        float m = -INFINITY;
        for (int i = lane; i < ch; i += 8) m = fmax(m, P[h][i]);
        m = sub_group_reduce_max(m);
        float s = 0.0f;
        for (int i = lane; i < ch; i += 8) { const float e = m == -INFINITY ? 0.0f : exp(P[h][i] - m); P[h][i] = e; s += e; }
        s = sub_group_reduce_add(s);
        if (lane == 0) { Ml[h] = m; Sl[h] = s; }
    }
    barrier(CLK_LOCAL_MEM_FENCE);
    // 3) V: lane owns 8 output dims; weights for 8 rows loaded at once, handed out by broadcast
    const int nr = min(ch, n_kv - r0);
    float8 o[H];
    for (int h = 0; h < H; h++) o[h] = (float8) 0.0f;
    for (int rr = 0; rr < nr; rr += 8) {
        float p[H];
        for (int h = 0; h < H; h++) p[h] = (rr + lane < nr) ? P[h][rr + lane] : 0.0f;
        const int nj = min(8, nr - rr);
        __global const half * vb = V + (size_t) (r0 + rr) * v_stride + lid * 8;
        if (0 < nj) { const float8 vv = vload_half8(0, vb + 0 * v_stride); o[0] = fma((float8) sub_group_broadcast(p[0], 0), vv, o[0]); o[1] = fma((float8) sub_group_broadcast(p[1], 0), vv, o[1]); o[2] = fma((float8) sub_group_broadcast(p[2], 0), vv, o[2]); o[3] = fma((float8) sub_group_broadcast(p[3], 0), vv, o[3]); o[4] = fma((float8) sub_group_broadcast(p[4], 0), vv, o[4]); o[5] = fma((float8) sub_group_broadcast(p[5], 0), vv, o[5]); o[6] = fma((float8) sub_group_broadcast(p[6], 0), vv, o[6]); o[7] = fma((float8) sub_group_broadcast(p[7], 0), vv, o[7]); }
        if (1 < nj) { const float8 vv = vload_half8(0, vb + 1 * v_stride); o[0] = fma((float8) sub_group_broadcast(p[0], 1), vv, o[0]); o[1] = fma((float8) sub_group_broadcast(p[1], 1), vv, o[1]); o[2] = fma((float8) sub_group_broadcast(p[2], 1), vv, o[2]); o[3] = fma((float8) sub_group_broadcast(p[3], 1), vv, o[3]); o[4] = fma((float8) sub_group_broadcast(p[4], 1), vv, o[4]); o[5] = fma((float8) sub_group_broadcast(p[5], 1), vv, o[5]); o[6] = fma((float8) sub_group_broadcast(p[6], 1), vv, o[6]); o[7] = fma((float8) sub_group_broadcast(p[7], 1), vv, o[7]); }
        if (2 < nj) { const float8 vv = vload_half8(0, vb + 2 * v_stride); o[0] = fma((float8) sub_group_broadcast(p[0], 2), vv, o[0]); o[1] = fma((float8) sub_group_broadcast(p[1], 2), vv, o[1]); o[2] = fma((float8) sub_group_broadcast(p[2], 2), vv, o[2]); o[3] = fma((float8) sub_group_broadcast(p[3], 2), vv, o[3]); o[4] = fma((float8) sub_group_broadcast(p[4], 2), vv, o[4]); o[5] = fma((float8) sub_group_broadcast(p[5], 2), vv, o[5]); o[6] = fma((float8) sub_group_broadcast(p[6], 2), vv, o[6]); o[7] = fma((float8) sub_group_broadcast(p[7], 2), vv, o[7]); }
        if (3 < nj) { const float8 vv = vload_half8(0, vb + 3 * v_stride); o[0] = fma((float8) sub_group_broadcast(p[0], 3), vv, o[0]); o[1] = fma((float8) sub_group_broadcast(p[1], 3), vv, o[1]); o[2] = fma((float8) sub_group_broadcast(p[2], 3), vv, o[2]); o[3] = fma((float8) sub_group_broadcast(p[3], 3), vv, o[3]); o[4] = fma((float8) sub_group_broadcast(p[4], 3), vv, o[4]); o[5] = fma((float8) sub_group_broadcast(p[5], 3), vv, o[5]); o[6] = fma((float8) sub_group_broadcast(p[6], 3), vv, o[6]); o[7] = fma((float8) sub_group_broadcast(p[7], 3), vv, o[7]); }
        if (4 < nj) { const float8 vv = vload_half8(0, vb + 4 * v_stride); o[0] = fma((float8) sub_group_broadcast(p[0], 4), vv, o[0]); o[1] = fma((float8) sub_group_broadcast(p[1], 4), vv, o[1]); o[2] = fma((float8) sub_group_broadcast(p[2], 4), vv, o[2]); o[3] = fma((float8) sub_group_broadcast(p[3], 4), vv, o[3]); o[4] = fma((float8) sub_group_broadcast(p[4], 4), vv, o[4]); o[5] = fma((float8) sub_group_broadcast(p[5], 4), vv, o[5]); o[6] = fma((float8) sub_group_broadcast(p[6], 4), vv, o[6]); o[7] = fma((float8) sub_group_broadcast(p[7], 4), vv, o[7]); }
        if (5 < nj) { const float8 vv = vload_half8(0, vb + 5 * v_stride); o[0] = fma((float8) sub_group_broadcast(p[0], 5), vv, o[0]); o[1] = fma((float8) sub_group_broadcast(p[1], 5), vv, o[1]); o[2] = fma((float8) sub_group_broadcast(p[2], 5), vv, o[2]); o[3] = fma((float8) sub_group_broadcast(p[3], 5), vv, o[3]); o[4] = fma((float8) sub_group_broadcast(p[4], 5), vv, o[4]); o[5] = fma((float8) sub_group_broadcast(p[5], 5), vv, o[5]); o[6] = fma((float8) sub_group_broadcast(p[6], 5), vv, o[6]); o[7] = fma((float8) sub_group_broadcast(p[7], 5), vv, o[7]); }
        if (6 < nj) { const float8 vv = vload_half8(0, vb + 6 * v_stride); o[0] = fma((float8) sub_group_broadcast(p[0], 6), vv, o[0]); o[1] = fma((float8) sub_group_broadcast(p[1], 6), vv, o[1]); o[2] = fma((float8) sub_group_broadcast(p[2], 6), vv, o[2]); o[3] = fma((float8) sub_group_broadcast(p[3], 6), vv, o[3]); o[4] = fma((float8) sub_group_broadcast(p[4], 6), vv, o[4]); o[5] = fma((float8) sub_group_broadcast(p[5], 6), vv, o[5]); o[6] = fma((float8) sub_group_broadcast(p[6], 6), vv, o[6]); o[7] = fma((float8) sub_group_broadcast(p[7], 6), vv, o[7]); }
        if (7 < nj) { const float8 vv = vload_half8(0, vb + 7 * v_stride); o[0] = fma((float8) sub_group_broadcast(p[0], 7), vv, o[0]); o[1] = fma((float8) sub_group_broadcast(p[1], 7), vv, o[1]); o[2] = fma((float8) sub_group_broadcast(p[2], 7), vv, o[2]); o[3] = fma((float8) sub_group_broadcast(p[3], 7), vv, o[3]); o[4] = fma((float8) sub_group_broadcast(p[4], 7), vv, o[4]); o[5] = fma((float8) sub_group_broadcast(p[5], 7), vv, o[5]); o[6] = fma((float8) sub_group_broadcast(p[6], 7), vv, o[6]); o[7] = fma((float8) sub_group_broadcast(p[7], 7), vv, o[7]); }
    }
    __global float * pc = part + (size_t) c * H * (2 + DV);
    for (int h = 0; h < H; h++) {
        if (lid == 0) { pc[h * (2 + DV)] = Ml[h]; pc[h * (2 + DV) + 1] = Sl[h]; }
        vstore8(o[h], 0, pc + h * (2 + DV) + 2 + lid * 8);
    }
}
