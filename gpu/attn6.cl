// Multi-query attention for one query token (decoding) -- v6: subgroup broadcasts instead of repeated loads.
#define H 8
#define DK 576
#define DV 512
#define WG 64
#define CHMAX 256
__attribute__((reqd_work_group_size(WG, 1, 1))) __attribute__((intel_reqd_sub_group_size(8)))
__kernel void attn_chunk(__global const half * K, ulong k_stride, __global const half * V, ulong v_stride,
                         __global const float * Q, ulong q_stride, __global const half * mask, float scale, int n_kv,
                         __global float * part, int ch) {
    __local float P[H][CHMAX];
    __local float Ml[H], Sl[H];
    const int c = get_group_id(0), lid = get_local_id(0), r0 = c * ch;
    const int sg = get_sub_group_id(), lane = get_sub_group_local_id();
    // 1) scores: lane = one cached row, all heads; the query comes by block read + register broadcast
    for (int j = 0; j < ch / WG; j++) {
        const int rl = j * WG + lid, r = r0 + rl;
        const bool live = r < n_kv;
        __global const half * kr = K + (size_t) (live ? r : 0) * k_stride;
        float acc[H];
        for (int h = 0; h < H; h++) acc[h] = 0.0f;
        for (int t = 0; t < DK / 64; t++) {
            float8 q[H];
            for (int h = 0; h < H; h++) q[h] = as_float8(intel_sub_group_block_read8((__global const uint *) (Q + h * q_stride + t * 64)));
            float8 kv;
            kv = vload_half8(0, kr + t * 64 + 0);
            acc[0] = fma(kv.s0, sub_group_broadcast(q[0].s0, 0), acc[0]); acc[1] = fma(kv.s0, sub_group_broadcast(q[1].s0, 0), acc[1]); acc[2] = fma(kv.s0, sub_group_broadcast(q[2].s0, 0), acc[2]); acc[3] = fma(kv.s0, sub_group_broadcast(q[3].s0, 0), acc[3]); acc[4] = fma(kv.s0, sub_group_broadcast(q[4].s0, 0), acc[4]); acc[5] = fma(kv.s0, sub_group_broadcast(q[5].s0, 0), acc[5]); acc[6] = fma(kv.s0, sub_group_broadcast(q[6].s0, 0), acc[6]); acc[7] = fma(kv.s0, sub_group_broadcast(q[7].s0, 0), acc[7]);
            acc[0] = fma(kv.s1, sub_group_broadcast(q[0].s0, 1), acc[0]); acc[1] = fma(kv.s1, sub_group_broadcast(q[1].s0, 1), acc[1]); acc[2] = fma(kv.s1, sub_group_broadcast(q[2].s0, 1), acc[2]); acc[3] = fma(kv.s1, sub_group_broadcast(q[3].s0, 1), acc[3]); acc[4] = fma(kv.s1, sub_group_broadcast(q[4].s0, 1), acc[4]); acc[5] = fma(kv.s1, sub_group_broadcast(q[5].s0, 1), acc[5]); acc[6] = fma(kv.s1, sub_group_broadcast(q[6].s0, 1), acc[6]); acc[7] = fma(kv.s1, sub_group_broadcast(q[7].s0, 1), acc[7]);
            acc[0] = fma(kv.s2, sub_group_broadcast(q[0].s0, 2), acc[0]); acc[1] = fma(kv.s2, sub_group_broadcast(q[1].s0, 2), acc[1]); acc[2] = fma(kv.s2, sub_group_broadcast(q[2].s0, 2), acc[2]); acc[3] = fma(kv.s2, sub_group_broadcast(q[3].s0, 2), acc[3]); acc[4] = fma(kv.s2, sub_group_broadcast(q[4].s0, 2), acc[4]); acc[5] = fma(kv.s2, sub_group_broadcast(q[5].s0, 2), acc[5]); acc[6] = fma(kv.s2, sub_group_broadcast(q[6].s0, 2), acc[6]); acc[7] = fma(kv.s2, sub_group_broadcast(q[7].s0, 2), acc[7]);
            acc[0] = fma(kv.s3, sub_group_broadcast(q[0].s0, 3), acc[0]); acc[1] = fma(kv.s3, sub_group_broadcast(q[1].s0, 3), acc[1]); acc[2] = fma(kv.s3, sub_group_broadcast(q[2].s0, 3), acc[2]); acc[3] = fma(kv.s3, sub_group_broadcast(q[3].s0, 3), acc[3]); acc[4] = fma(kv.s3, sub_group_broadcast(q[4].s0, 3), acc[4]); acc[5] = fma(kv.s3, sub_group_broadcast(q[5].s0, 3), acc[5]); acc[6] = fma(kv.s3, sub_group_broadcast(q[6].s0, 3), acc[6]); acc[7] = fma(kv.s3, sub_group_broadcast(q[7].s0, 3), acc[7]);
            acc[0] = fma(kv.s4, sub_group_broadcast(q[0].s0, 4), acc[0]); acc[1] = fma(kv.s4, sub_group_broadcast(q[1].s0, 4), acc[1]); acc[2] = fma(kv.s4, sub_group_broadcast(q[2].s0, 4), acc[2]); acc[3] = fma(kv.s4, sub_group_broadcast(q[3].s0, 4), acc[3]); acc[4] = fma(kv.s4, sub_group_broadcast(q[4].s0, 4), acc[4]); acc[5] = fma(kv.s4, sub_group_broadcast(q[5].s0, 4), acc[5]); acc[6] = fma(kv.s4, sub_group_broadcast(q[6].s0, 4), acc[6]); acc[7] = fma(kv.s4, sub_group_broadcast(q[7].s0, 4), acc[7]);
            acc[0] = fma(kv.s5, sub_group_broadcast(q[0].s0, 5), acc[0]); acc[1] = fma(kv.s5, sub_group_broadcast(q[1].s0, 5), acc[1]); acc[2] = fma(kv.s5, sub_group_broadcast(q[2].s0, 5), acc[2]); acc[3] = fma(kv.s5, sub_group_broadcast(q[3].s0, 5), acc[3]); acc[4] = fma(kv.s5, sub_group_broadcast(q[4].s0, 5), acc[4]); acc[5] = fma(kv.s5, sub_group_broadcast(q[5].s0, 5), acc[5]); acc[6] = fma(kv.s5, sub_group_broadcast(q[6].s0, 5), acc[6]); acc[7] = fma(kv.s5, sub_group_broadcast(q[7].s0, 5), acc[7]);
            acc[0] = fma(kv.s6, sub_group_broadcast(q[0].s0, 6), acc[0]); acc[1] = fma(kv.s6, sub_group_broadcast(q[1].s0, 6), acc[1]); acc[2] = fma(kv.s6, sub_group_broadcast(q[2].s0, 6), acc[2]); acc[3] = fma(kv.s6, sub_group_broadcast(q[3].s0, 6), acc[3]); acc[4] = fma(kv.s6, sub_group_broadcast(q[4].s0, 6), acc[4]); acc[5] = fma(kv.s6, sub_group_broadcast(q[5].s0, 6), acc[5]); acc[6] = fma(kv.s6, sub_group_broadcast(q[6].s0, 6), acc[6]); acc[7] = fma(kv.s6, sub_group_broadcast(q[7].s0, 6), acc[7]);
