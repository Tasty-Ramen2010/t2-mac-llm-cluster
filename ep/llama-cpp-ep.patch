+static bool ggml_fa_mqa_decode_ok(const ggml_tensor * dst) {
+    static const bool on = [] { const char * e = getenv("GGML_FA_MQA"); return !(e && e[0] == '0'); }();
+    const ggml_tensor * q = dst->src[0], * k = dst->src[1], * v = dst->src[2], * mask = dst->src[3];
+    float max_bias;
+    memcpy(&max_bias, (float *) dst->op_params + 1, sizeof(float));
+    if (!(on && q->ne[1] == 1 && q->ne[3] == 1 && q->type == GGML_TYPE_F32 && k->type == GGML_TYPE_F16 &&
+          v->type == GGML_TYPE_F16 && k->ne[3] == 1 && v->ne[3] == 1 && k->ne[2] == v->ne[2] && k->ne[2] >= 1 &&
+          q->ne[2] % k->ne[2] == 0 && k->ne[0] % 8 == 0 && v->ne[0] % 8 == 0 && k->ne[0] <= 1024 && v->ne[0] <= 1024 &&
+          max_bias == 0.0f && (!mask || mask->ne[2] == 1))) {
+        return false;
+    }
+    const int64_t G = q->ne[2] / k->ne[2];               // query heads per kv head
+    return G >= 2 && G <= 16;
+}
