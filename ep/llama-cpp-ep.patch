+#pragma once
+
+// Integrated-GPU co-worker for CPU matmuls (Intel iGPU via OpenCL, zero copy on host memory).
+// For single-token GEMV on repacked Q4_0 (block_q4_0x8) weights, the iGPU computes the first rows of the output
+// while the CPU threads compute the rest: both read the same RAM, and on small CPUs the CPU kernels alone
+// leave some memory bandwidth unused. Enabled with GGML_IGPU=<fraction of rows>, e.g. GGML_IGPU=0.25.
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ggml_tensor;
+
+// rows (multiple of 64) the iGPU should take for this matmul, 0 = none. Pure function of shapes + env, so every
+// thread computes the same value.
+int64_t ggml_igpu_q4x8_rows(const struct ggml_tensor * src0, const struct ggml_tensor * src1);
+
+// start the iGPU on rows [0, rows); returns an opaque handle, or NULL on failure (caller computes those rows itself)
+void * ggml_igpu_q4x8_launch(const struct ggml_tensor * src0, const struct ggml_tensor * src1, struct ggml_tensor * dst, int64_t rows);
+
+// wait for a launch to finish
+void ggml_igpu_wait(void * handle);
+
+// iGPU attention co-worker (GGML_IGPU_ATTN=<fraction>): cached rows [0, rows) go to the iGPU, 0 = none.
+// Pure function of shapes + env, so every thread computes the same value.
+int64_t ggml_igpu_attn_rows(const struct ggml_tensor * dst);
+void *  ggml_igpu_attn_launch(const struct ggml_tensor * dst, int64_t rows);
+// wait, then write the merged partial (M, S, sum p*V[dv]) of every head to out + h * out_stride; false if no job
+bool    ggml_igpu_attn_wait(void * handle, float * out, int64_t n_heads, int64_t dv, int64_t out_stride);
+
+#ifdef __cplusplus
+}
+#endif
