+// Lean GEMV for q4_0x8 / mxfp4x8 (single token decode; memory-bound on small CPUs, so every uop counts).
+// vs gemv_q4_b32_8x8_q8_0_lut_avx: unsigned LUT (value + OFF) so maddubs needs no sign fix-ups -- the exact
+// correction -OFF*sum(a) is preloaded into the int accumulator; four maddubs are summed in int16 before one
+// madd (max 4*2*24*127 < 32767); activations are broadcast straight from memory (load port, not the shuffle
+// port); e8m0 scales are decoded as a vector. GGML_LEAN_GEMV=0 falls back to the original kernel.
+static bool ggml_lean_gemv_enabled() {
+    static const bool on = [] { const char * e = getenv("GGML_LEAN_GEMV"); return !(e && e[0] == '0'); }();
+    return on;
+}
+
+template<typename block_tx8, int OFF>
+static void gemv_b32_8x8_q8_0_lean_avx2(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc, __m256i ulut) {
+    const int nb = n / QK8_0;
+    UNUSED(bs);
+    const __m256i finalpermutemask = _mm256_set_epi32(7, 5, 3, 1, 6, 4, 2, 0);
+    const __m256i m4b    = _mm256_set1_epi8(0x0F);
+    const __m256i ones16 = _mm256_set1_epi16(1);
+    const __m256i ones8  = _mm256_set1_epi8(1);
+    const __m256i eperm  = _mm256_set_epi32(7, 3, 6, 2, 5, 1, 4, 0);
+    const block_tx8  * b_ptr_start = (const block_tx8  *)vx;
+    const block_q8_0 * a_ptr_start = (const block_q8_0 *)vy;
+
+    int32_t corr[512];   // -OFF * sum(a) per activation block
+    for (int64_t y = 0; y < nr; y++) {
+        const block_q8_0 * a_ptr = a_ptr_start + (y * nb);
+        for (int b = 0; b < nb; b++) {
+            const __m256i a = _mm256_loadu_si256((const __m256i *)a_ptr[b].qs);
+            __m256i t = _mm256_madd_epi16(_mm256_maddubs_epi16(ones8, a), ones16);
+            __m128i h = _mm_add_epi32(_mm256_castsi256_si128(t), _mm256_extracti128_si256(t, 1));
+            h = _mm_add_epi32(h, _mm_shuffle_epi32(h, 0x4E));
+            h = _mm_add_epi32(h, _mm_shuffle_epi32(h, 0xB1));
+            corr[b] = -OFF * _mm_cvtsi128_si32(h);
+        }
+        for (int64_t x = 0; x < nc / 8; x++) {
+            const block_tx8 * b_ptr = b_ptr_start + (x * nb);
+            __m256 acc_row = _mm256_setzero_ps();
+            for (int64_t b = 0; b < nb; b++) {
+                const __m256i r0 = _mm256_loadu_si256((const __m256i *)(b_ptr[b].qs));
+                const __m256i r1 = _mm256_loadu_si256((const __m256i *)(b_ptr[b].qs) + 1);
+                const __m256i r2 = _mm256_loadu_si256((const __m256i *)(b_ptr[b].qs) + 2);
+                const __m256i r3 = _mm256_loadu_si256((const __m256i *)(b_ptr[b].qs) + 3);
+                const __m256i w0123_0 = _mm256_shuffle_epi8(ulut, _mm256_and_si256(r0, m4b));
+                const __m256i w4567_0 = _mm256_shuffle_epi8(ulut, _mm256_and_si256(r1, m4b));
+                const __m256i w0123_1 = _mm256_shuffle_epi8(ulut, _mm256_and_si256(r2, m4b));
+                const __m256i w4567_1 = _mm256_shuffle_epi8(ulut, _mm256_and_si256(r3, m4b));
+                const __m256i w0123_2 = _mm256_shuffle_epi8(ulut, _mm256_and_si256(_mm256_srli_epi16(r0, 4), m4b));
+                const __m256i w4567_2 = _mm256_shuffle_epi8(ulut, _mm256_and_si256(_mm256_srli_epi16(r1, 4), m4b));
+                const __m256i w0123_3 = _mm256_shuffle_epi8(ulut, _mm256_and_si256(_mm256_srli_epi16(r2, 4), m4b));
+                const __m256i w4567_3 = _mm256_shuffle_epi8(ulut, _mm256_and_si256(_mm256_srli_epi16(r3, 4), m4b));
+
+                const int32_t * aq = (const int32_t *) a_ptr[b].qs;
+                #define LEAN_MUL(wA, wB, k) \
+                    _mm256_maddubs_epi16(_mm256_blend_epi32(wA, _mm256_shuffle_epi32(wB, 177), 170), _mm256_set1_epi32(aq[k])), \
+                    _mm256_maddubs_epi16(_mm256_blend_epi32(_mm256_shuffle_epi32(wA, 177), wB, 170), _mm256_set1_epi32(aq[k + 1]))
+                const __m256i p[8] = { LEAN_MUL(w0123_0, w4567_0, 0), LEAN_MUL(w0123_1, w4567_1, 2),
+                                       LEAN_MUL(w0123_2, w4567_2, 4), LEAN_MUL(w0123_3, w4567_3, 6) };
+                #undef LEAN_MUL
+                const __m256i s0 = _mm256_add_epi16(_mm256_add_epi16(p[0], p[1]), _mm256_add_epi16(p[2], p[3]));
+                const __m256i s1 = _mm256_add_epi16(_mm256_add_epi16(p[4], p[5]), _mm256_add_epi16(p[6], p[7]));
+                const __m256i iacc = _mm256_add_epi32(_mm256_set1_epi32(corr[b]),
+                                     _mm256_add_epi32(_mm256_madd_epi16(s0, ones16), _mm256_madd_epi16(s1, ones16)));
+
+                __m256 col_scale_f32;
+                if constexpr (std::is_same_v<block_tx8, block_q4_0x8>) {
+                    const __m128i changemask = _mm_set_epi8(15, 14, 7, 6, 13, 12, 5, 4, 11, 10, 3, 2, 9, 8, 1, 0);
+                    col_scale_f32 = GGML_F32Cx8_REARRANGE_LOAD(b_ptr[b].d, changemask);
+                } else {
+                    // e8m0 "half": 2^(e-128) == float bits (e-1)<<23 (e <= 1 flushes to 0, a subnormal before)
+                    const __m128i e = _mm_subs_epu8(_mm_loadl_epi64((const __m128i *) b_ptr[b].e), _mm_set1_epi8(1));
+                    col_scale_f32 = _mm256_permutevar8x32_ps(_mm256_castsi256_ps(_mm256_slli_epi32(_mm256_cvtepu8_epi32(e), 23)), eperm);
+                }
+                const __m256 row_scale_f32 = _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(a_ptr[b].d));
+                acc_row = _mm256_fmadd_ps(_mm256_cvtepi32_ps(iacc), _mm256_mul_ps(col_scale_f32, row_scale_f32), acc_row);
+            }
+            acc_row = _mm256_permutevar8x32_ps(acc_row, finalpermutemask);
+            _mm256_storeu_ps(s + (y * nr + x * 8), acc_row);
+        }
+    }
+}
