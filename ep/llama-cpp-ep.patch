+}
+
+// zero-copy cl_mem covering [p, p+n) of the backend buffer holding tensor t; *off = p - window start
+cl_mem window_for(const ggml_tensor * t, const void * pv, size_t n, size_t * off) {
+    auto & s = S();
+    const char * p = (const char *) pv;
+    std::lock_guard<std::mutex> lock(s.mu);
+    for (auto & w : s.wins) {
+        if (p >= w.base && p + n <= w.base + w.size) { *off = p - w.base; return w.mem; }
+    }
+    // one window per whole backend buffer: the Intel driver aborts on overlapping host-pointer buffers
+    ggml_backend_buffer_t buf = t->view_src ? t->view_src->buffer : t->buffer;
+    if (!buf) return nullptr;
+    const char * start = (const char *) ggml_backend_buffer_get_base(buf);
+    const size_t size  = ggml_backend_buffer_get_size(buf) / 64 * 64;
+    if (((uintptr_t) start & 4095) != 0 || p < start || p + n > start + size) return nullptr;  // zero copy needs page alignment
+    cl_int err;
+    cl_mem m = clCreateBuffer(s.ctx, CL_MEM_READ_WRITE | CL_MEM_USE_HOST_PTR | CL_MEM_ALLOW_UNRESTRICTED_SIZE_INTEL, size, (void *) start, &err);
+    if (err != CL_SUCCESS) { fprintf(stderr, "ggml-igpu: zero-copy buffer of %zu MB failed (%d)\n", size >> 20, err); return nullptr; }
+    s.wins.push_back({start, size, m});
+    *off = p - start;
+    return m;
+}
+
+} // namespace
+
+extern "C" int64_t ggml_igpu_q4x8_rows(const ggml_tensor * src0, const ggml_tensor * src1) {
+    auto & s = S();
+    if (!s.ok || src1->ne[1] != 1 || src1->ne[2] != 1 || src0->ne[1] < s.min_rows || src0->ne[0] > 16384) return 0;
+    return (int64_t) (src0->ne[1] * s.frac) / (8 * SUBGROUPS) * (8 * SUBGROUPS);
+}
+
+extern "C" void * ggml_igpu_q4x8_launch(const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst, int64_t rows) {
+    auto & s = S();
+    const int nb = (int) (src0->ne[0] / 32);
+    size_t woff, xoff, yoff;
+    const size_t wbytes = (size_t) rows / 8 * nb * 144;          // block_q4_0x8 = 144 bytes per 8 rows x 32 columns
+    cl_mem W = window_for(src0, src0->data, wbytes, &woff);
+    cl_mem X = window_for(src1, src1->data, src0->ne[0] * sizeof(float), &xoff);
+    cl_mem Y = window_for(dst, dst->data, rows * sizeof(float), &yoff);
+    if (!W || !X || !Y) return nullptr;
+    cl_ulong wo = woff, xo = xoff, yo = yoff;
+    clSetKernelArg(s.k, 0, sizeof(cl_mem), &W); clSetKernelArg(s.k, 1, sizeof(cl_ulong), &wo);
+    clSetKernelArg(s.k, 2, sizeof(cl_mem), &X); clSetKernelArg(s.k, 3, sizeof(cl_ulong), &xo);
+    clSetKernelArg(s.k, 4, sizeof(cl_mem), &Y); clSetKernelArg(s.k, 5, sizeof(cl_ulong), &yo);
+    clSetKernelArg(s.k, 6, sizeof(int), &nb);   clSetKernelArg(s.k, 7, (size_t) nb * 32 * sizeof(float), nullptr);
+    const size_t ls = 16 * SUBGROUPS, gs = (size_t) rows / 8 * 16;
+    cl_event ev = nullptr;
+    if (clEnqueueNDRangeKernel(s.q, s.k, 1, nullptr, &gs, &ls, 0, nullptr, &ev) != CL_SUCCESS) return nullptr;
+    clFlush(s.q);
+    return ev;
+}
