+}
+
+// combine the per-chunk partials into one (M, S, sum p*V) per head; work-group = one head, lane = 8 dims
+__attribute__((reqd_work_group_size(WG, 1, 1)))
+__kernel void attn_merge(__global const float * part, int n_chunks, __global float * out) {
+    const int h = get_group_id(0), lid = get_local_id(0);
+    float M = -INFINITY, S = 0.0f;
+    float8 acc = (float8) 0.0f;
+    for (int c = 0; c < n_chunks; c++) {
+        __global const float * pc = part + ((size_t) c * H + h) * (2 + DV);
+        const float Mc = pc[0], Sc = pc[1];
+        if (Sc == 0.0f) continue;
