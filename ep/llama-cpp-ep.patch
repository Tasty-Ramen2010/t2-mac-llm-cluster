+// GGML_Q5X8_CHECK=1: compare the AVX2 kernel with the plain C reference on the first calls and report the worst error
+static void q5x8_selfcheck(int n, const float * s, size_t bs, const void * vx, const void * vy, int nr, int nc, bool is_gemm) {
+    static int left = -1;
+    if (left < 0) { const char * e = getenv("GGML_Q5X8_CHECK"); left = (e && e[0] == '1') ? 40 : 0; }
+    if (left <= 0) return;
+    left--;
+    std::vector<float> ref((size_t) (is_gemm ? nr * bs : nc));
+    if (is_gemm) ggml_gemm_q5_0_8x8_q8_0_generic(n, ref.data(), bs, vx, vy, nr, nc);
+    else         ggml_gemv_q5_0_8x8_q8_0_generic(n, ref.data(), bs, vx, vy, nr, nc);
+    double worst = 0, scale = 1e-6;
+    for (int m = 0; m < (is_gemm ? nr : 1); m++)
+        for (int c = 0; c < nc; c++) {
+            const float a = s[m * (is_gemm ? bs : 0) + c], b = ref[m * (is_gemm ? bs : 0) + c];
+            worst = std::max(worst, (double) std::fabs(a - b));
+            scale = std::max(scale, (double) std::fabs(b));
+        }
+    fprintf(stderr, "q5_0x8 %s check: n=%d nc=%d nr=%d max |fast-ref| = %.3g (rel %.3g)\n", is_gemm ? "gemm" : "gemv", n, nc, nr, worst, worst / scale);
+}
+
+void ggml_gemv_q5_0_8x8_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+#if defined(__AVX2__) || defined(__AVX512F__)
+    gemv_q5_0_8x8_q8_0_lean_avx2(n, s, vx, vy, nc);
+    q5x8_selfcheck(n, s, bs, vx, vy, nr, nc, false);
+#else
+    ggml_gemv_q5_0_8x8_q8_0_generic(n, s, bs, vx, vy, nr, nc);
+#endif
+}
+
+// prompt batches: 4 activation rows arrive interleaved (block_q8_0x4, 8-byte chunks); split them and run the gemv per row
+void ggml_gemm_q5_0_8x8_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+#if defined(__AVX2__) || defined(__AVX512F__)
+    const int nb = n / QK8_0;
+    std::vector<block_q8_0> rows((size_t) 4 * nb);
+    for (int y = 0; y < nr / 4; y++) {
+        const block_q8_0x4 * a_ptr = (const block_q8_0x4 *) vy + (y * nb);
+        for (int l = 0; l < nb; l++) {
+            for (int m = 0; m < 4; m++) {
+                block_q8_0 & r = rows[(size_t) m * nb + l];
+                r.d = a_ptr[l].d[m];
+                for (int c = 0; c < 4; c++) {       // chunk c holds weights (c>>1)*16 + (c&1)*8 .. +8 of row m
+                    memcpy(r.qs + (c >> 1) * 16 + (c & 1) * 8, a_ptr[l].qs + c * 32 + m * 8, 8);
+                }
+            }
+        }
+        for (int m = 0; m < 4; m++) {
+            gemv_q5_0_8x8_q8_0_lean_avx2(n, s + (size_t) (y * 4 + m) * bs, vx, rows.data() + (size_t) m * nb, nc);
+        }
+    }
+    q5x8_selfcheck(n, s, bs, vx, vy, nr, nc, true);
+#else
+    ggml_gemm_q5_0_8x8_q8_0_generic(n, s, bs, vx, vy, nr, nc);
+#endif
+}
