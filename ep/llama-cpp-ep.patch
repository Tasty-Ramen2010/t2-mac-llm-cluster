+static void ggml_fa_mqa_decode_chunk(const ggml_tensor * dst, int64_t ic0, int64_t ic1, float * partials, int64_t partial_stride) {
+    for (int64_t g = 0; g < dst->src[1]->ne[2]; g++) {
+        ggml_fa_mqa_decode_group(dst, g, ic0, ic1, partials, partial_stride);
+    }
