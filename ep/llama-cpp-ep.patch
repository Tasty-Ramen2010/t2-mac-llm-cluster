+    const int nb = n / QK8_0;
+    UNUSED(bs);
+    UNUSED(nr);
+    const block_q8_0 * a_ptr = (const block_q8_0 *) vy;
+    for (int x = 0; x < nc / 8; x++) {
+        const block_q5_0x8 * b_ptr = (const block_q5_0x8 *) vx + (x * nb);
+        for (int r = 0; r < 8; r++) {
+            float sumf = 0.0f;
+            for (int l = 0; l < nb; l++) {
+                int sumi = 0;
