+// Decode fast path for multi-query attention (one query token, many heads sharing ONE f16 K/V head -- e.g. DeepSeek
+// MLA, where V is even a view of the first DV values of each K row). The generic path runs every head separately:
+// it re-reads and re-converts each cached row once per head and keeps its V accumulator in f16 (converted back and
+// forth for every row). Here each block of rows is converted to f32 once, all heads are scored together (one
+// register accumulator per head), and V is accumulated for all heads from the same converted rows, in f32.
+// Writes the same per-thread partials (M, S, VKQ) as the split-KV path. GGML_FA_MQA=0 disables it,
+// GGML_FA_MQA_CHECK=1 compares it with the generic path on the first calls.
+#if defined(__AVX2__) && defined(__FMA__)
+#include <immintrin.h>
+#endif
