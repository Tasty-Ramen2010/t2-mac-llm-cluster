@@ -0,0 +1,222 @@
+// ep-run: expert/tensor parallel gpt-oss across two machines.
+//   leader  (LLAMA_EP_RANK=0): runs a prompt; libllama mirrors every decode/memory call to the follower
+//           (any libllama program works as leader when LLAMA_EP_CTRL is set, e.g. llama-server)
+//   follower (LLAMA_EP_RANK=1, --follow): replays the mirrored calls so both ranks stay in lockstep
+// Peer data link and model split are configured with LLAMA_EP_* env vars (see src/llama-ep.h).
+
+#include "llama.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+
+#include <netdb.h>
+#include <netinet/tcp.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+static void die(const char * m) { fprintf(stderr, "ep-run: %s\n", m); exit(1); }
+
+// returns false on clean EOF before any byte
+// While generating, the leader's next instruction arrives within ~1 ms: spin (non-blocking recv) for up to 20 ms so
+// node2 starts the next token without a sleep/wake-up; after that block, so an idle follower uses no CPU.
+static bool recv_all(int fd, void * p, size_t n) {
+    char * c = (char *) p;
+    size_t got = 0;
+    auto t0 = std::chrono::steady_clock::now();
+    bool spin = true;
+    while (got < n) {
+        ssize_t k = recv(fd, c + got, n - got, spin ? MSG_DONTWAIT : 0);
+        if (k < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            if (std::chrono::steady_clock::now() - t0 > std::chrono::milliseconds(20)) spin = false;
+            continue;
+        }
+        if (k == 0 && got == 0) return false;
+        if (k <= 0) die("control connection lost");
+        got += (size_t) k;
+        t0 = std::chrono::steady_clock::now();
+    }
+    return true;
+}
+
+static int connect_ctrl(const std::string & addr) {
+    std::string host = addr.substr(0, addr.rfind(':')), port = addr.substr(addr.rfind(':') + 1);
+    addrinfo hints = {}, * res = nullptr;
+    hints.ai_socktype = SOCK_STREAM;
+    if (getaddrinfo(host.c_str(), port.c_str(), &hints, &res) != 0) die("resolve ctrl addr");
+    int fd = -1, one = 1;
+    for (int i = 0; i < 3000 && fd < 0; i++) {
+        fd = socket(res->ai_family, SOCK_STREAM, 0);
+        if (connect(fd, res->ai_addr, res->ai_addrlen) != 0) { close(fd); fd = -1; usleep(200000); }
+    }
+    freeaddrinfo(res);
+    if (fd < 0) die("connect ctrl");
+    setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    return fd;
+}
+
+static void follow(int cfd, llama_context * ctx) {
+    llama_memory_t mem = llama_get_memory(ctx);
+    std::vector<llama_token> tok; std::vector<float> embd; std::vector<llama_pos> pos;
+    std::vector<int32_t> nsid; std::vector<llama_seq_id> sid; std::vector<llama_seq_id *> sidp; std::vector<int8_t> logits;
+    int32_t h[5];
+    long n_decode = 0;
+    while (recv_all(cfd, h, sizeof(h))) {
+        switch (h[0]) {
+            case 1: {  // decode
+                const int32_t n = h[1], flags = h[2], n_embd = h[3];
+                llama_batch b = {};
+                b.n_tokens = n;
+                if (flags & 1)  { tok.resize(n);  recv_all(cfd, tok.data(), n * sizeof(llama_token)); b.token = tok.data(); }
+                if (flags & 2)  { embd.resize((size_t) n * n_embd); recv_all(cfd, embd.data(), embd.size() * sizeof(float)); b.embd = embd.data(); }
+                if (flags & 4)  { pos.resize(n);  recv_all(cfd, pos.data(), n * sizeof(llama_pos)); b.pos = pos.data(); }
+                if (flags & 8)  {
+                    nsid.resize(n); recv_all(cfd, nsid.data(), n * sizeof(int32_t));
+                    size_t tot = 0; for (int32_t v : nsid) tot += v;
+                    sid.resize(tot); sidp.resize(n);
+                    size_t off = 0;
+                    for (int32_t i = 0; i < n; i++) { sidp[i] = sid.data() + off; recv_all(cfd, sidp[i], nsid[i] * sizeof(llama_seq_id)); off += nsid[i]; }
+                    b.n_seq_id = nsid.data(); b.seq_id = sidp.data();
+                }
+                if (flags & 16) { logits.resize(n); recv_all(cfd, logits.data(), n); b.logits = logits.data(); }
+                llama_decode(ctx, b);
+                n_decode++;
+                break;
+            }
+            case 2: llama_memory_clear(mem, h[1]); break;
+            case 3: llama_memory_seq_rm(mem, h[1], h[2], h[3]); break;
+            case 4: llama_memory_seq_cp(mem, h[1], h[2], h[3], h[4]); break;
+            case 5: llama_memory_seq_keep(mem, h[1]); break;
+            case 6: llama_memory_seq_add(mem, h[1], h[2], h[3], h[4]); break;
+            case 7: llama_memory_seq_div(mem, h[1], h[2], h[3], h[4]); break;
+            case 8: llama_set_warmup(ctx, h[1]); break;
+            default: die("unknown mirrored op");
+        }
+    }
+    fprintf(stderr, "ep-run: leader disconnected after %ld decodes\n", n_decode);
+}
+
+int main(int argc, char ** argv) {
+    std::string model_path, prompt = "Explain in two sentences why the sky is blue.", ctrl;
+    int n_predict = 64, n_threads = 4, n_ctx = 4096;
+    bool repack = false, no_mmap = false, follower = false, tmpl = false, swa_small = false;
+    int poll = 50, prio = 0; std::string cpumask;
+    for (int i = 1; i < argc; i++) {
+        std::string a = argv[i];
+        if (a == "-m" && i + 1 < argc) model_path = argv[++i];
+        else if (a == "-p" && i + 1 < argc) prompt = argv[++i];
+        else if (a == "-n" && i + 1 < argc) n_predict = atoi(argv[++i]);
+        else if (a == "-t" && i + 1 < argc) n_threads = atoi(argv[++i]);
+        else if (a == "-c" && i + 1 < argc) n_ctx = atoi(argv[++i]);
+        else if (a == "--ctrl" && i + 1 < argc) ctrl = argv[++i];
+        else if (a == "--repack") repack = true;
+        else if (a == "--no-mmap") no_mmap = true;
+        else if (a == "--follow") follower = true;
+        else if (a == "--tmpl") tmpl = true;
+        else if (a == "--swa-small") swa_small = true;
+        else if (a == "--poll" && i + 1 < argc) poll = atoi(argv[++i]);      // 0..100: how long idle workers spin before sleeping
+        else if (a == "--prio" && i + 1 < argc) prio = atoi(argv[++i]);      // 0 normal, 1 medium, 2 high, 3 realtime
+        else if (a == "--cpumask" && i + 1 < argc) cpumask = argv[++i];      // e.g. "0,1,2": pin worker i to the i-th listed cpu  // sliding-window layers keep only the window (the leader runs without --swa-full)  // use the model's own chat template instead of the gpt-oss harmony prompt
+    }
+    if (model_path.empty() || !getenv("LLAMA_EP_RANK")) die("usage: LLAMA_EP_*=... ep-run -m model [--ctrl host:port] [--follow] [-p prompt] [-n N] [-t threads]");
+    const char * addr_env = getenv("LLAMA_EP_ADDR");
+    const bool solo = addr_env && std::string(addr_env) == "solo";
+    if (!solo && ctrl.empty()) die("--ctrl is required unless LLAMA_EP_ADDR=solo");
+    if (!follower && !solo) setenv("LLAMA_EP_CTRL", ctrl.c_str(), 1);  // libllama mirrors calls to the follower
+
+    const int cfd = follower ? connect_ctrl(ctrl) : -1;
+
+    llama_backend_init();
+    llama_model_params mp = llama_model_default_params();
+    mp.n_gpu_layers    = 0;
+    mp.load_mode       = no_mmap ? LLAMA_LOAD_MODE_NONE : LLAMA_LOAD_MODE_MMAP;
+    mp.use_extra_bufts = repack;  // only safe with a sliced model: repacking copies every expert in the file into RAM
+    llama_model * model = llama_model_load_from_file(model_path.c_str(), mp);
+    if (!model) die("load model");
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    llama_context_params cp = llama_context_default_params();
+    cp.n_ctx = n_ctx; cp.n_batch = 512; cp.n_ubatch = 512;
+    cp.n_threads = n_threads; cp.n_threads_batch = n_threads;
+    cp.swa_full = !swa_small;   // must match the leader: llama-server --swa-full (default here) or not (--swa-small)
+    llama_context * ctx = llama_init_from_model(model, cp);
+    if (!ctx) die("create context");
+
+    // a persistent thread pool (like llama-server's): without one, ggml creates and joins fresh worker threads for
+    // every graph, i.e. for every token
+    ggml_threadpool_params tpp;
+    ggml_threadpool_params_init(&tpp, n_threads);
+    tpp.poll = poll;
+    tpp.prio = (ggml_sched_priority) prio;
+    if (!cpumask.empty()) {
+        size_t pos = 0;
+        while (pos < cpumask.size()) {
+            const int c = atoi(cpumask.c_str() + pos);
+            if (c >= 0 && c < GGML_MAX_N_THREADS) tpp.cpumask[c] = true;
+            pos = cpumask.find(',', pos);
+            if (pos == std::string::npos) break;
+            pos++;
+        }
+        tpp.strict_cpu = true;
+    }
+    ggml_threadpool * tp = ggml_threadpool_new(&tpp);
+    if (!tp) die("threadpool");
+    llama_attach_threadpool(ctx, tp, nullptr);
+    fprintf(stderr, "ep-run: thread pool %d threads, poll %d, prio %d%s%s\n", n_threads, poll, prio,
+            cpumask.empty() ? "" : ", cpus ", cpumask.c_str());
+
+    if (follower) {
+        follow(cfd, ctx);
+    } else {
+        std::string text = "<|start|>system<|message|>Reasoning: low<|end|><|start|>user<|message|>" + prompt +
+                           "<|end|><|start|>assistant";
+        if (tmpl) {
+            const llama_chat_message msg = { "user", prompt.c_str() };
+            std::vector<char> buf(prompt.size() * 2 + 1024);
+            const int len = llama_chat_apply_template(llama_model_chat_template(model, nullptr), &msg, 1, true, buf.data(), buf.size());
+            if (len < 0 || len > (int) buf.size()) die("chat template");
+            text.assign(buf.data(), len);
+        }
+        std::vector<llama_token> toks(text.size() + 16);
+        int n = llama_tokenize(vocab, text.c_str(), text.size(), toks.data(), toks.size(), false, true);
+        if (n < 0) die("tokenize");
+        toks.resize(n);
+
+        auto t0 = std::chrono::steady_clock::now();
+        if (llama_decode(ctx, llama_batch_get_one(toks.data(), toks.size()))) die("decode prompt");
+        auto t1 = std::chrono::steady_clock::now();
+
+        const int n_vocab = llama_vocab_n_tokens(vocab);
+        int generated = 0;
+        auto tg0 = t1;
+        for (int i = 0; i < n_predict; i++) {
+            const float * lg = llama_get_logits_ith(ctx, -1);
+            llama_token best = 0;
+            for (int v = 1; v < n_vocab; v++) if (lg[v] > lg[best]) best = v;
+            if (i == 0) tg0 = std::chrono::steady_clock::now();
+            char buf[256];
+            int k = llama_token_to_piece(vocab, best, buf, sizeof(buf), 0, true);
+            if (k > 0) { fwrite(buf, 1, k, stdout); fflush(stdout); }
+            generated++;
+            if (llama_vocab_is_eog(vocab, best)) break;
+            if (llama_decode(ctx, llama_batch_get_one(&best, 1))) die("decode token");
+        }
+        auto tg1 = std::chrono::steady_clock::now();
+        const double pp_s = std::chrono::duration<double>(t1 - t0).count();
+        const double tg_s = std::chrono::duration<double>(tg1 - tg0).count();
+        fprintf(stderr, "\n\nep-run: prompt %d tokens in %.2fs (%.1f t/s) | generated %d tokens, %.2f t/s\n",
+                (int) toks.size(), pp_s, toks.size() / pp_s, generated, (generated - 1) / tg_s);
+    }
+    llama_free(ctx);
+    ggml_threadpool_free(tp);
+    llama_model_free(model);
+    llama_backend_free();
+    if (cfd >= 0) close(cfd);
+    return 0;
+}
