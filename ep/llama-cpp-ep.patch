+        acc = acc * a + vload8(0, pc + 2 + lid * 8) * b;
+        S = S * a + Sc * b;
+        M = Mn;
+    }
+    __global float * o = out + (size_t) h * (2 + DV);
+    if (lid == 0) { o[0] = M; o[1] = S; }
+    vstore8(acc, 0, o + 2 + lid * 8);
+}
+)CLC";
+
+struct attn_prog { int h, dk, dv; cl_kernel k_chunk, k_merge; };
+
+struct attn_state {
+    bool             ok = false;
+    float            frac = 0.0f;
+    int64_t          min_rows = 1536;
+    cl_device_id     dev = nullptr;
+    cl_context       ctx = nullptr;
+    cl_command_queue q = nullptr;
+    std::vector<attn_prog> progs;
+    std::vector<window>    wins;
+    float *          part = nullptr;   // per-chunk partials (host memory, zero copy)
+    float *          fin  = nullptr;   // merged per-head partials
+    cl_mem           m_part = nullptr, m_fin = nullptr;
+    size_t           part_cap = 0;
+    std::mutex       mu;
+};
+
+attn_state & A() {
+    static attn_state s;
+    static std::once_flag once;
+    std::call_once(once, [] {
+        const char * e = getenv("GGML_IGPU_ATTN");
+        if (!e || atof(e) <= 0) return;
+        s.frac = (float) atof(e);
+        if (const char * m = getenv("GGML_IGPU_ATTN_MIN")) s.min_rows = atoll(m);
+        cl_platform_id p; cl_int err;
+        if (clGetPlatformIDs(1, &p, nullptr) != CL_SUCCESS || clGetDeviceIDs(p, CL_DEVICE_TYPE_GPU, 1, &s.dev, nullptr) != CL_SUCCESS) {
+            fprintf(stderr, "ggml-igpu-attn: no OpenCL GPU, disabled\n"); return;
+        }
+        s.ctx = clCreateContext(nullptr, 1, &s.dev, nullptr, nullptr, &err);
+        s.q   = clCreateCommandQueueWithProperties(s.ctx, s.dev, nullptr, &err);
+        s.part_cap = (size_t) 8 << 20;                                  // 8 MB of chunk partials, 64 KB merged
+        s.part = (float *) aligned_alloc(4096, s.part_cap);
+        s.fin  = (float *) aligned_alloc(4096, 65536);
+        s.m_part = clCreateBuffer(s.ctx, CL_MEM_READ_WRITE | CL_MEM_USE_HOST_PTR, s.part_cap, s.part, &err);
+        s.m_fin  = clCreateBuffer(s.ctx, CL_MEM_READ_WRITE | CL_MEM_USE_HOST_PTR, 65536, s.fin, &err);
+        s.ok = err == CL_SUCCESS;
+        char name[256] = {0}; clGetDeviceInfo(s.dev, CL_DEVICE_NAME, sizeof(name), name, nullptr);
+        fprintf(stderr, "ggml-igpu-attn: %s takes %.0f%% of cached rows (from %lld rows)\n", name, s.frac * 100, (long long) s.min_rows);
+    });
+    return s;
+}
+
+attn_prog * attn_prog_for(int h, int dk, int dv) {
+    auto & s = A();
+    for (auto & p : s.progs) if (p.h == h && p.dk == dk && p.dv == dv) return p.k_chunk ? &p : nullptr;
+    char opts[256];
+    snprintf(opts, sizeof(opts), "-cl-std=CL1.2 -cl-mad-enable -cl-fast-relaxed-math -DH=%d -DDK=%d -DDV=%d", h, dk, dv);
+    cl_int err;
+    cl_program pr = clCreateProgramWithSource(s.ctx, 1, &a_src, nullptr, &err);
+    attn_prog ap = { h, dk, dv, nullptr, nullptr };
+    if (clBuildProgram(pr, 1, &s.dev, opts, nullptr, nullptr) != CL_SUCCESS) {
+        static char log[16384]; clGetProgramBuildInfo(pr, s.dev, CL_PROGRAM_BUILD_LOG, sizeof(log), log, nullptr);
+        fprintf(stderr, "ggml-igpu-attn: kernel build failed (%s):\n%s\n", opts, log);
+    } else {
+        ap.k_chunk = clCreateKernel(pr, "attn_chunk", &err);
+        ap.k_merge = clCreateKernel(pr, "attn_merge", &err);
+    }
+    s.progs.push_back(ap);
+    return ap.k_chunk ? &s.progs.back() : nullptr;
+}
+
+cl_mem attn_window(const ggml_tensor * t, const void * pv, size_t n, size_t * off) {
+    auto & s = A();
+    const char * p = (const char *) pv;
+    for (auto & w : s.wins) {
+        if (p >= w.base && p + n <= w.base + w.size) { *off = p - w.base; return w.mem; }
+    }
+    ggml_backend_buffer_t buf = t->view_src ? t->view_src->buffer : t->buffer;
+    if (!buf) return nullptr;
+    const char * start = (const char *) ggml_backend_buffer_get_base(buf);
+    const size_t size  = ggml_backend_buffer_get_size(buf) / 64 * 64;
+    if (((uintptr_t) start & 4095) != 0 || p < start || p + n > start + size) return nullptr;
+    cl_int err;
+    cl_mem m = clCreateBuffer(s.ctx, CL_MEM_READ_WRITE | CL_MEM_USE_HOST_PTR | CL_MEM_ALLOW_UNRESTRICTED_SIZE_INTEL, size, (void *) start, &err);
+    if (err != CL_SUCCESS) { fprintf(stderr, "ggml-igpu-attn: zero-copy window of %zu MB failed (%d)\n", size >> 20, err); return nullptr; }
+    s.wins.push_back({start, size, m});
+    *off = p - start;
+    return m;
+}
+
+} // namespace
+
+extern "C" int64_t ggml_igpu_attn_rows(const ggml_tensor * dst) {
+    auto & s = A();
+    const ggml_tensor * q = dst->src[0], * k = dst->src[1], * v = dst->src[2];
+    if (!s.ok || k->ne[2] != 1 || q->ne[2] != 8 || v->ne[0] != 512 || k->ne[0] % 64 != 0 || k->ne[1] < s.min_rows) return 0;
+    return (int64_t) (k->ne[1] * s.frac) / 64 * 64;
+}
+
+extern "C" void * ggml_igpu_attn_launch(const ggml_tensor * dst, int64_t rows) {
+    auto & s = A();
+    std::lock_guard<std::mutex> lock(s.mu);
+    const ggml_tensor * q = dst->src[0], * k = dst->src[1], * v = dst->src[2], * mask = dst->src[3];
+    attn_prog * ap = attn_prog_for((int) q->ne[2], (int) k->ne[0], (int) v->ne[0]);
+    if (!ap) return nullptr;
+    const int H = (int) q->ne[2], DV = (int) v->ne[0];
+    int ch = 64;
+    while (ch < 256 && (rows + ch - 1) / ch > 72) ch *= 2;
+    const int n_chunks = (int) ((rows + ch - 1) / ch);
+    if ((size_t) n_chunks * H * (2 + DV) * sizeof(float) > s.part_cap) return nullptr;
+    size_t koff, voff, qoff, moff = 0;
+    cl_mem K = attn_window(k, k->data, (size_t) rows * k->nb[1], &koff);
+    cl_mem V = attn_window(v, v->data, (size_t) rows * v->nb[1], &voff);
+    cl_mem Q = attn_window(q, q->data, (size_t) H * q->nb[2], &qoff);
+    cl_mem M = mask ? attn_window(mask, mask->data, (size_t) rows * sizeof(ggml_fp16_t), &moff) : nullptr;
+    if (!K || !V || !Q || (mask && !M)) return nullptr;
+    if (koff % 2 || voff % 2 || qoff % 4 || moff % 2) return nullptr;
+    float scale;
+    memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+    const cl_ulong ko = koff / 2, vo = voff / 2, qo = qoff / 4, mo = moff / 2;
+    const cl_ulong ks = k->nb[1] / 2, vs = v->nb[1] / 2, qs = q->nb[2] / 4;
+    const int n_kv = (int) rows, has_mask = M != nullptr;
+    cl_mem Mb = M ? M : K;                       // any valid buffer when there is no mask
+    cl_kernel kc = ap->k_chunk;
+    clSetKernelArg(kc, 0, sizeof(cl_mem), &K);  clSetKernelArg(kc, 1, sizeof(cl_ulong), &ko); clSetKernelArg(kc, 2, sizeof(cl_ulong), &ks);
+    clSetKernelArg(kc, 3, sizeof(cl_mem), &V);  clSetKernelArg(kc, 4, sizeof(cl_ulong), &vo); clSetKernelArg(kc, 5, sizeof(cl_ulong), &vs);
+    clSetKernelArg(kc, 6, sizeof(cl_mem), &Q);  clSetKernelArg(kc, 7, sizeof(cl_ulong), &qo); clSetKernelArg(kc, 8, sizeof(cl_ulong), &qs);
+    clSetKernelArg(kc, 9, sizeof(cl_mem), &Mb); clSetKernelArg(kc, 10, sizeof(cl_ulong), &mo); clSetKernelArg(kc, 11, sizeof(int), &has_mask);
+    clSetKernelArg(kc, 12, sizeof(float), &scale); clSetKernelArg(kc, 13, sizeof(int), &n_kv);
+    clSetKernelArg(kc, 14, sizeof(cl_mem), &s.m_part); clSetKernelArg(kc, 15, sizeof(int), &ch);
+    const size_t lws = DV / 8, gws = (size_t) n_chunks * lws;
+    cl_kernel km = ap->k_merge;
+    clSetKernelArg(km, 0, sizeof(cl_mem), &s.m_part); clSetKernelArg(km, 1, sizeof(int), &n_chunks); clSetKernelArg(km, 2, sizeof(cl_mem), &s.m_fin);
+    const size_t gws2 = (size_t) H * lws;
+    cl_event ev = nullptr;
+    if (clEnqueueNDRangeKernel(s.q, kc, 1, nullptr, &gws, &lws, 0, nullptr, nullptr) != CL_SUCCESS ||
+        clEnqueueNDRangeKernel(s.q, km, 1, nullptr, &gws2, &lws, 0, nullptr, &ev) != CL_SUCCESS) {
+        ev = nullptr;
+    }
+    clFlush(s.q);
+    return ev;
+}
+
+extern "C" bool ggml_igpu_attn_wait(void * handle, float * out, int64_t n_heads, int64_t dv, int64_t out_stride) {
+    if (!handle) return false;
+    cl_event ev = (cl_event) handle;
+    // poll instead of sleeping in the driver: the result is due in well under a millisecond
+    cl_int st = CL_QUEUED;
+    for (;;) {
+        if (clGetEventInfo(ev, CL_EVENT_COMMAND_EXECUTION_STATUS, sizeof(st), &st, nullptr) != CL_SUCCESS || st <= CL_COMPLETE) break;
+    }
+    if (st < 0) clWaitForEvents(1, &ev);
+    clReleaseEvent(ev);
+    auto & s = A();
+    for (int64_t h = 0; h < n_heads; h++) memcpy(out + h * out_stride, s.fin + h * (2 + dv), (2 + dv) * sizeof(float));
+    return true;
+}
