+            fprintf(stderr, "ggml-igpu: kernel build failed:\n%s\n", log); return;
+        }
+        s.k = clCreateKernel(pr, "gemv_q4x8", &err);
+        s.ok = err == CL_SUCCESS;
+        char name[256] = {0}; clGetDeviceInfo(d, CL_DEVICE_NAME, sizeof(name), name, nullptr);
+        fprintf(stderr, "ggml-igpu: %s takes %.0f%% of rows of Q4_0 GEMVs with >= %lld rows\n", name, s.frac * 100, (long long) s.min_rows);
