+// weight k (0..31) of interleaved row r (0..7) of a block_q5_0x8, as a signed value (-16..15)
+static inline int q5_0x8_weight(const block_q5_0x8 & b, int r, int k) {
+    const int half = k >> 4, kk = k & 15;
+    const int j  = ((kk >> 3) << 1) | (r >> 2);      // which 32-byte slice of qs
+    const int bb = (r & 3) * 8 + (kk & 7);            // byte inside it
+    const int v  = half * 4 + j;                       // vector index in the AVX2 kernel
+    const int lo = (b.qs[32 * j + bb] >> (4 * half)) & 0xF;
+    const int hi = (b.qh[bb] >> v) & 1;
+    return (lo | (hi << 4)) - 16;
+}
