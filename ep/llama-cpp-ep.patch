+    for (int r = 0; r < 8; r++) { const float t = sub_group_reduce_add(acc[r]); if (lane == r) y[g * 8 + r] = t; }
+}
+)CLC";
+
+constexpr int    SUBGROUPS = 8;               // per work-group -> 64 rows per work-group
+#define CL_MEM_ALLOW_UNRESTRICTED_SIZE_INTEL (1 << 23)   // lets one zero-copy buffer exceed the ~3.3 GiB max alloc
+
+struct window { const char * base; size_t size; cl_mem mem; };
+
+struct state {
+    bool             ok = false;
+    float            frac = 0.0f;
+    int64_t          min_rows = 2048;
+    cl_context       ctx = nullptr;
+    cl_command_queue q = nullptr;
+    cl_kernel        k = nullptr;
+    std::vector<window> wins;
+    std::mutex       mu;
+};
+
+state & S() {
+    static state s;
+    static std::once_flag once;
+    std::call_once(once, [] {
+        const char * e = getenv("GGML_IGPU");
+        if (!e || atof(e) <= 0) return;
+        s.frac = (float) atof(e);
+        if (const char * m = getenv("GGML_IGPU_MIN_ROWS")) s.min_rows = atoll(m);
+        cl_platform_id p; cl_device_id d; cl_int err;
+        if (clGetPlatformIDs(1, &p, nullptr) != CL_SUCCESS || clGetDeviceIDs(p, CL_DEVICE_TYPE_GPU, 1, &d, nullptr) != CL_SUCCESS) {
+            fprintf(stderr, "ggml-igpu: no OpenCL GPU, disabled\n"); return;
+        }
+        s.ctx = clCreateContext(nullptr, 1, &d, nullptr, nullptr, &err);
+        s.q   = clCreateCommandQueueWithProperties(s.ctx, d, nullptr, &err);
+        cl_program pr = clCreateProgramWithSource(s.ctx, 1, &k_src, nullptr, &err);
+        if (clBuildProgram(pr, 1, &d, "-cl-std=CL2.0 -cl-mad-enable -cl-intel-greater-than-4GB-buffer-required", nullptr, nullptr) != CL_SUCCESS) {
